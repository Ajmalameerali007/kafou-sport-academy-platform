# Server-only; never prefix credentials with NEXT_PUBLIC_ or VITE_.
SUPABASE_URL=https://your-staging-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-server-only-secret-key
APP_URL=http://localhost:3100
RATE_LIMIT_SECRET=replace-with-a-random-32-byte-secret
KAFOU_STAGING=true
# true only for captured local mail or verified hosted SMTP/test recipients.
AUTH_EMAIL_ENABLED=false
